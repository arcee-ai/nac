{
  "name": "nac-electron",
  "version": "0.0.0",
  "private": true,
  "description": "NAC Mac development shell; Rust owns the engine and production React workspace",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "prepare:dev": "node scripts/prepare.cjs",
    "test": "node --test test/*.test.cjs",
    "test:e2e": "playwright test -c playwright.config.cjs",
    "package": "node scripts/package.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "electron": "45.3.2"
  }
}
