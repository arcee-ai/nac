{
  "purpose": "one owner-authorized 90-second test-only diagnostic after original 20-second FAIL",
  "sources": [
    {
      "namespace": "flux-system",
      "name": "flux-system",
      "url": "ssh://git@github.com/arcee-ai/flux-k8s-infra",
      "revision": "main@sha1:6e2d88b5c26fc5cc1757301f69d9fbbaa38f7463"
    },
    {
      "namespace": "flux-system",
      "name": "nac-managed-controller",
      "url": "https://github.com/arcee-ai/managed-nac-controller",
      "revision": "main@sha1:e39a0da3613e005a7eaa0846ea99d3906cef055b"
    }
  ],
  "runtime": {
    "handler": "runsc",
    "scheduling": {
      "nodeSelector": {
        "sandbox.gvisor.dev/runtime": "runsc"
      },
      "tolerations": [
        {
          "effect": "NoSchedule",
          "key": "sandbox.gvisor.dev/runtime",
          "operator": "Equal",
          "value": "runsc"
        }
      ]
    }
  },
  "storage": {
    "provisioner": "ebs.csi.aws.com",
    "parameters": {
      "encrypted": "true",
      "fsType": "ext4",
      "type": "gp3"
    },
    "reclaimPolicy": "Delete"
  },
  "existing_managed_security_contract_preserved": true
}
